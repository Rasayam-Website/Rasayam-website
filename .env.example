# ── Core Django ───────────────────────────────────────────────────────────────
DEBUG=False
STRICT_PRODUCTION_ENV=True
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=rasayam.com,www.rasayam.com,your-alb-dns.ap-south-1.elb.amazonaws.com
CSRF_TRUSTED_ORIGINS=https://rasayam.com,https://www.rasayam.com
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
DJANGO_LOG_LEVEL=INFO

# ── Gunicorn / app runtime ────────────────────────────────────────────────────
PORT=8000
# WEB_CONCURRENCY overrides CPU-auto-scaled worker count when set explicitly.
# Leave unset to let entrypoint.sh compute (2 * nproc + 1).
# WEB_CONCURRENCY=5
GUNICORN_TIMEOUT=120
RUN_MIGRATIONS_ON_STARTUP=false

# ── Database ──────────────────────────────────────────────────────────────────
# Use DATABASE_URL (preferred) OR the individual DB_* vars — not both.
DATABASE_URL=postgres://db_user:db_password@rds-endpoint.ap-south-1.rds.amazonaws.com:5432/rasayam
# DB_NAME=rasayam
# DB_USER=rasayam_user
# DB_PASSWORD=replace-me
# DB_HOST=rds-endpoint.ap-south-1.rds.amazonaws.com
# DB_PORT=5432

# ── Redis cache ───────────────────────────────────────────────────────────────
REDIS_URL=redis://your-elasticache-endpoint.ap-south-1.cache.amazonaws.com:6379/0

# ── AWS credentials ───────────────────────────────────────────────────────────
# Prefer an IAM instance role or ECS task role over static keys.
# Only set these when running outside AWS (local dev, CI).
# AWS_ACCESS_KEY_ID=replace-me
# AWS_SECRET_ACCESS_KEY=replace-me
AWS_DEFAULT_REGION=ap-south-1
AWS_S3_REGION_NAME=ap-south-1

# ── S3 media bucket (user-uploaded images) ────────────────────────────────────
AWS_STORAGE_BUCKET_NAME=rasayam-media-prod
AWS_QUERYSTRING_AUTH=False
# Point to a CloudFront distribution in front of the media bucket:
# AWS_S3_CUSTOM_DOMAIN=media.rasayam.com
# Override Cache-Control header on uploaded objects:
# AWS_S3_CACHE_CONTROL=max-age=86400, public

# ── S3 static bucket (collectstatic output) ───────────────────────────────────
# May be the same bucket as AWS_STORAGE_BUCKET_NAME (files go under static/ prefix).
# Set to a separate bucket if you want to isolate static assets.
AWS_STATIC_BUCKET_NAME=rasayam-static-prod
# Space-separated list of origins allowed to fetch static/media assets:
# AWS_S3_CORS_ALLOW_ORIGINS=https://rasayam.com https://www.rasayam.com

# ── Cloudinary (fallback when S3 is not configured) ───────────────────────────
# Leave blank if S3 is used.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Payments ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=replace-me
RAZORPAY_KEY_SECRET=replace-me

# Webhook secret — copy from Razorpay Dashboard → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET=replace-me

# ── Zavu SMS Gateway ─────────────────────────────────────────────────────────
ZAVU_API_KEY=replace-me
ZAVU_SENDER_ID=kd76wwx3z18f1scm0bz6t8332s8c4dp9
ZAVU_API_URL=https://api.zavu.dev/v1/messages
